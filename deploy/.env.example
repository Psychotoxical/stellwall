# Copy to .env next to compose.yaml and fill in.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
PUBLIC_URL=https://stellwall.example.com
TZ=Europe/Berlin
# Optional: put the Firebase service account file into ./secrets and name it here.
# FIREBASE_ACCOUNT_FILE=/run/stellwall/firebase.json
# Documents need a key file in ./secrets (32 random bytes, readable by uid 1000); this is its default place.
# DOCS_KEY_FILE=/run/stellwall/documents.key
